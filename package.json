  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "undici": ">=7.30.1 <8",
      "flatted": ">=3.4.2",
      "hono": ">=4.13.5",
      "@hono/node-server": ">=2.0.10",
      "path-to-regexp": ">=8.4.2",
      "postcss": ">=8.5.23",
      "nanoid@3": ">=3.3.18",
      "js-yaml@4": ">=4.3.2",
