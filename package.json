      "zod@4": ">=4.6.6 <5",
      "systeminformation@5": ">=5.33.16 <6"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "msw",
      "sharp",
      "unrs-resolver"
