{
  "name": "prompt-area-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev --turbopack",
    "prebuild": "pnpm registry:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "registry:build": "shadcn build",
    "typecheck": "tsc --noEmit",
    "package:build": "pnpm --filter prompt-area build",
    "package:typecheck": "pnpm --filter prompt-area typecheck",
    "package:check": "pnpm --filter prompt-area lint:exports",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@posthog/types": "^1.416.0",
